          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(litellm_output_reasoning_tokens_metric_total{namespace=~\"$namespace\"}[5m]))",
          "refId": "D",
          "legendFormat": "reasoning output"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 54,
      "type": "timeseries",
      "title": "Tokens /s by model",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
