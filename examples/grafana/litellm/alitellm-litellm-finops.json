          },
          "expr": "count(litellm_key_expiry{namespace=~\"$namespace\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "Every key in the LiteLLM database, including ones with no traffic since the proxy started — the callback metrics cannot see these."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
