          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (model) (rate(litellm_input_tokens_metric_total{namespace=~\"$namespace\"}[5m])) + sum by (model) (rate(litellm_output_tokens_metric_total{namespace=~\"$namespace\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 55,
      "panels": [],
      "title": "Inventory & budgets (DB truth — litellm-exporter)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 56,
      "type": "stat",
      "title": "Lifetime spend (all keys, DB)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(litellm_total_spend{namespace=~\"$namespace\"})",
          "refId": "A"
        }
      ],
      "description": "From the exporter, which reads the LiteLLM database: survives proxy restarts and counts entities with no recent traffic. The callback counter above only covers traffic since the proxy started."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 57,
      "type": "stat",
      "title": "Budget utilization",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(litellm_budget_utilization{namespace=~\"$namespace\"})",
          "refId": "A"
        }
      ],
      "description": "The exporter reports this as a 0-100 percentage, not a 0-1 ratio."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 58,
